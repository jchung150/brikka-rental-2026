// 가전/가구 테이블
model BuildingApplianceFurniture {
  /// 항목 고유 ID
  id                   BigInt      @id @default(autoincrement())
  usageScope           UsageScope? @default(BUILDING_COMMON)
  /// 소속 건물 ID (건물 공용일 경우)
  buildingId           BigInt?
  /// 소속 유닛 ID (유닛 전용일 경우)
  unitId               BigInt?
  /// 수량
  quantity             Int         @default(1)
  applianceFurnitureId BigInt
  /// 제조사 (예: '삼성전자')
  manufacturerId       BigInt
  /// 설치 위치 (예: '거실')
  locationId           BigInt?
  /// 모델명
  modelName            String?     @db.VarChar(100)
  /// 일련번호
  serialNumber         String?     @db.VarChar(100)
  /// 설치 일자
  installationDate     DateTime?   @db.Date
  /// 보증 만료 일자
  warrantyExpiryDate   DateTime?   @db.Date
  /// 메모
  memo                 String?
  /// 생성일시
  createdAt            DateTime    @default(now()) @db.Timestamptz
  /// 최종 수정일시,,
  updatedAt            DateTime    @updatedAt @db.Timestamptz

  Building           Building?                      @relation(fields: [buildingId], references: [id])
  Unit               Unit?                          @relation(fields: [unitId], references: [id])
  /// 제품 ID
  ApplianceFurniture ApplianceFurniture             @relation(fields: [applianceFurnitureId], references: [id])
  Manufacturer       ApplianceFurnitureManufacturer @relation(fields: [manufacturerId], references: [id])
  Location           ApplianceFurnitureLocation?    @relation(fields: [locationId], references: [id])

  @@index([applianceFurnitureId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([buildingId])
  @@index([unitId])
  @@map("building_appliances_furniture")
}

// 가전/가구 제품 테이블
model ApplianceFurniture {
  /// 제품 고유 ID
  id          BigInt                     @id @default(autoincrement())
  /// 제품 구분 (가전제품/가구)
  category    ApplianceFurnitureCategory
  /// 제품명
  name        String                     @db.VarChar(100)
  /// 제품 설명
  description String?                    @db.VarChar(255)
  /// 생성일시
  createdAt   DateTime                   @default(now()) @db.Timestamptz

  BuildingApplianceFurniture BuildingApplianceFurniture[]

  @@unique([name])
  @@map("appliances_furniture")
}

// 가전/가구 브랜드 테이블
model ApplianceFurnitureManufacturer {
  /// 브랜드 고유 ID
  id                         BigInt                       @id @default(autoincrement())
  /// 브랜드명
  name                       String                       @db.VarChar(100)
  /// 생성일시
  createdAt                  DateTime                     @default(now()) @db.Timestamptz
  BuildingApplianceFurniture BuildingApplianceFurniture[]

  @@unique([name])
  @@map("appliances_furniture_manufacturers")
}

// 가전/가구 위치 테이블
model ApplianceFurnitureLocation {
  /// 위치 고유 ID
  id                         BigInt                       @id @default(autoincrement())
  /// 위치명
  name                       String                       @db.VarChar(100)
  /// 생성일시
  createdAt                  DateTime                     @default(now()) @db.Timestamptz
  BuildingApplianceFurniture BuildingApplianceFurniture[]

  @@index([name])
  @@map("appliances_furniture_locations")
}

// 파일 테이블
model File {
  /// 파일 고유 ID
  id            BigInt   @id @default(autoincrement())
  /// 파일을 업로드한 사용자 ID
  uploaderId    BigInt?
  /// 파일 저장 경로 (예: S3 key)
  filePath      String
  /// 원본 파일 이름
  fileName      String
  /// 파일 URL
  fileUrl       String
  /// 파일 크기 (Bytes)
  fileSizeBytes BigInt
  /// 파일 MIME 타입 (예: 'image/jpeg')
  mimeType      String   @db.VarChar(255)
  /// 파일 접근 권한 (True: 비공개)
  isPrivate     Boolean  @default(true)
  /// 생성일시
  createdAt     DateTime @default(now()) @db.Timestamptz

  // 관계
  Uploader    User?       @relation(fields: [uploaderId], references: [id])
  Attachments Attachment?

  @@index([uploaderId])
  @@map("files")
}

// 메시지 테이블
model Message {
  /// 메시지 고유 ID
  id          BigInt        @id @default(autoincrement())
  /// 메시지 제목
  title       String        @db.VarChar(255)
  /// 메시지 내용
  content     String        @db.Text
  /// 결제 관련 정보 (JSON)
  payment     Json?
  /// 전송 방법
  method      MessageMethod
  /// 수신인 ID (사용자)
  receiverId  BigInt
  /// 메시지 타입
  messageType String        @db.VarChar(100)
  /// 관련 임대차 계약 ID (선택적)
  leaseId     BigInt?
  /// 관련 건물 ID (선택적)
  buildingId  BigInt?
  /// 관련 청구서 ID (선택적)
  billId      BigInt?
  /// 생성일시
  createdAt   DateTime      @default(now()) @db.Timestamptz
  /// 최종 수정일시
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  // 관계
  User     User      @relation(fields: [receiverId], references: [id])
  Lease    Lease?    @relation(fields: [leaseId], references: [id])
  Building Building? @relation(fields: [buildingId], references: [id])
  Bill     Bill?     @relation(fields: [billId], references: [id])

  @@index([receiverId])
  @@index([leaseId])
  @@index([buildingId])
  @@index([billId])
  @@index([method])
  @@index([messageType])
  @@map("messages")
}

// 알림 설정 테이블 (single table 구조)
model AlarmConfig {
  /// 알림 설정 고유 ID (항상 1로 고정)
  id BigInt @id @default(1)

  // 계약 및 거주 관련 알림
  /// 세입자 퇴거 알림서 제출 시 알림 설정 (ALARM_TALK|EMAIL)
  tenantMoveOut  String? @db.VarChar(50)
  /// 계약 만료 예정 리마인더 알림 설정 (ALARM_TALK|EMAIL)
  contractExpiry String? @db.VarChar(50)

  // 청구 및 수납 관련 알림
  /// 임대료 미납 발생 시 알림 설정 (ALARM_TALK|EMAIL)
  rentUnpaid         String? @db.VarChar(50)
  /// 미납 상태 지속 알림 설정 (ALARM_TALK|EMAIL)
  rentUnpaidReminder String? @db.VarChar(50)
  /// 자동 수납 처리 결과 알림 설정 (ALARM_TALK|EMAIL)
  autoPaymentResult  String? @db.VarChar(50)

  // 수선 요청/업무 알림
  /// 신규 수선 요청 등록 알림 설정 (ALARM_TALK|EMAIL)
  newRepairRequest    String? @db.VarChar(50)
  /// 담당 업무 배정 알림 설정 (ALARM_TALK|EMAIL)
  taskAssignment      String? @db.VarChar(50)
  /// 요청 상태 변경 알림 설정 (ALARM_TALK|EMAIL)
  requestStatusChange String? @db.VarChar(50)

  // 문서 및 알림 관련
  /// 공지사항 발송 완료 알림 설정 (ALARM_TALK|EMAIL)
  noticeSent String? @db.VarChar(50)

  // 계정 및 보안 관련
  /// 관리자 계정 변경 알림 설정 (ALARM_TALK|EMAIL)
  adminAccountChange   String? @db.VarChar(50)
  /// 비밀번호 재설정 요청 알림 설정 (ALARM_TALK|EMAIL)
  passwordResetRequest String? @db.VarChar(50)

  /// 생성일시
  createdAt DateTime @default(now()) @db.Timestamptz
  /// 최종 수정일시
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("alarm_config")
}

// 임대차 중개사 테이블
