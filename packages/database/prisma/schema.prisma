enum UsageScope {
  BUILDING_COMMON
  UNIT_COMMON
  UNIT_EXCLUSIVE
}

enum RequestSource {
  TENANT_REQUEST // 입주자요청
  TENANT_FACE_TO_FACE // 입주자 대면요청
  LANDLORD_REQUEST // 임대인 요청
  LANDLORD_FACE_TO_FACE // 임대인 대면요청
  INTERNAL // 내부등록
}

enum UserRole {
  ADMIN // 슈퍼관리자
  MANAGER // 매니저
  TENANT // 입주자
  LANDLORD // 임대인
}

enum UserPermissionType {
  MANAGER_GENERAL // 일반 관리권한
  MANAGER_FACILITY // 시설 관리권한
  USER_MANAGEMENT // 사용자 관리권한
  BUILDING_MANAGEMENT // 건물 관리권한
  LEASE_MANAGEMENT // 임대차 관리권한
  BILLING_MANAGEMENT // 청구 관리권한
  REPORT_VIEW // 리포트 조회권한
  SYSTEM_SETTINGS // 시스템 설정권한
}

enum UnitStatus {
  VACANT // 공실
  OCCUPIED // 입주중
  RESERVED // 예약중
  UNDER_CONSTRUCTION // 공사중
}

enum LeaseStatus {
  PREPARING // 준비중 - 계약이 생성되었지만 아직 확정/시작 전인 상태 (대시보드에서 신규 계약 등록만 입력한 상태)
  ACTIVE // 진행중 - 신규계약등록 입력 및 계약서 날인 후 계약금이 들어온 상태
  COMPLETED // 종료됨 - 계약 만료가 되어 정상적으로 종료된 상태
  TERMINATED // 해지됨 - 분쟁, 위반 등의 이유로 계약이 강제 종료되거나 무효 처리된 상태
}

enum RecurrenceType {
  RECURRING // 반복
  ONE_TIME // 한번
}

enum RecurrencePeriod {
  MONTHLY // 월별
  QUARTERLY // 분기별
  YEARLY // 연간
}

enum NotificationChannel {
  ALIMTALK // 알림톡
  EMAIL // 이메일
  SMS // SMS
}

enum BillStatus {
  PAID // 납부완료
  UNPAID // 미납
  OVERDUE // 연체
}

enum RequestType {
  COMPLAINT // 민원
  SUGGESTION // 제안
  INQUIRY // 문의
  REPAIR // 수선
}

enum RequestStatus {
  PENDING // 미분류
  IN_PROGRESS // 처리중
  COMPLETED // 완료
  CANCELED // 보류
  REJECTED // 거부
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum ParkingSpaceType {
  NORMAL
  COMPACT
  HANDICAPPED
}

enum ApplianceFurnitureCategory {
  APPLIANCE
  FURNITURE
}

enum MessageMethod {
  ALARM_TALK // 알림톡
  EMAIL // 이메일
}

// 투어 예약 설정 테이블
model ContactConfig {
  /// 설정 고유 ID (항상 1로 고정)
  id        BigInt   @id @default(1)
  /// 투어 운영 시작 시간 (HH:mm 형식)
  start     String   @db.VarChar(5)
  /// 투어 운영 종료 시간 (HH:mm 형식)
  end       String   @db.VarChar(5)
  /// 생성일시
  createdAt DateTime @default(now()) @db.Timestamptz
  /// 최종 수정일시
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("contact_config")
}

// 투어 예약 정보 테이블
model Contact {
  /// 예약 고유 ID
  id              BigInt        @id @default(autoincrement())
  /// 예약자 성함
  name            String        @db.VarChar(100)
  /// 예약자 이메일
  email           String?       @db.VarChar(255)
  /// 예약자 전화번호
  phoneNumber     String?       @db.VarChar(20)
  /// 알게된 경로
  howDidYouFind   String?       @db.VarChar(255)
  /// 메모
  memo            String?
  /// 동
  dong            String?       @db.VarChar(100)
  /// 유형
  type            String?       @db.VarChar(100)
  /// 예약 시간
  reservationTime DateTime      @db.Timestamptz
  /// 예약 상태
  status          ContactStatus @default(PENDING)
  /// 관리자 메모
  adminMemo       String?
  /// 생성일시
  createdAt       DateTime      @default(now()) @db.Timestamptz
  /// 최종 수정일시
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  @@index([status])
  @@index([reservationTime])
  @@map("contacts")
}

enum ContactStatus {
  PENDING // 대기중
  CONFIRMED // 확정
  COMPLETED // 완료
  CANCELLED // 취소
}

// 변경이력 테이블
model ChangeHistory {
  /// 변경이력 고유 ID
  id         BigInt           @id @default(autoincrement())
  /// 대상 유형
  targetType ChangeTargetType
  /// 대상 ID
  targetId   BigInt
  /// 수정한 사용자 ID
  userId     BigInt
  /// 변경값 (before/after)
  changes    Json
  /// 생성일시
  createdAt  DateTime         @default(now()) @db.Timestamptz

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
  @@map("change_histories")
}

enum ChangeTargetType {
  BUILDING // 건물
  UNIT // 유닛
  LEASE // 계약
  USER // 사용자
  BILLING // 청구
  PAYMENT // 수납
  MESSAGE // 메시지
}
